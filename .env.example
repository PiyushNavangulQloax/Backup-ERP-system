# ==============================================================================
# Manufacturing ERP 2.0 - Environment Configuration
# ==============================================================================

# Server Environment
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL default; supports SQLite for zero-setup dev)
DATABASE_URL=file:./dev.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manufacturing_erp?schema=public

# Authentication Secrets
JWT_SECRET=super-secret-manufacturing-erp-jwt-key-change-in-production-2026
JWT_EXPIRATION=3600s
JWT_REFRESH_SECRET=super-refresh-token-manufacturing-erp-key-change-in-prod-2026
JWT_REFRESH_EXPIRATION=604800s

# Storage
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_MAX_FILE_SIZE_MB=10

# Redis & Background Jobs (Optional in standalone dev)
REDIS_HOST=localhost
REDIS_PORT=6379
